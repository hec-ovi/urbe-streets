{
  "name": "urbe-streets",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "Builds reusable 8 m street GLBs and placements from Atlas reservations with exact ground replacement and native material bindings.",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "generate": "node --experimental-strip-types src/cli/main.ts",
    "test:city": "node --experimental-strip-types tests/city.ts",
    "test:compression": "node --experimental-strip-types src/assets/compression-sample.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "clipper2-ts": "2.0.1-18",
    "earcut": "3.2.3",
    "meshoptimizer": "1.1.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/earcut": "3.0.0",
    "@types/node": "22.20.2",
    "@types/three": "0.185.4",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
