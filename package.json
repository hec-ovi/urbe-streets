{
  "name": "urbe-streets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Builds streamable GLB street assets from saved Atlas construction with retained ground ownership and seeded Materials bindings.",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "node --experimental-strip-types src/cli/main.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "clipper2-ts": "2.0.1-18",
    "earcut": "3.2.3"
  },
  "devDependencies": {
    "@types/earcut": "3.0.0",
    "@types/node": "22.20.2",
    "@types/three": "0.185.4",
    "three": "0.185.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
